# ---------- Django ----------
SECRET_KEY=change-this-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
# Set this only if you use PostgreSQL (leave empty to use SQLite locally)
DATABASE_URL=

# ---------- WhatsApp Cloud API (Meta sandbox) ----------
WHATSAPP_ACCESS_TOKEN=your_test_token
PHONE_NUMBER_ID=your_test_phone_number_id
WHATSAPP_API_VERSION=v20.0

# ---------- Email ----------
# EMAIL_PROVIDER = postmark | brevo | resend | console
EMAIL_PROVIDER=postmark
POSTMARKAPP_TOKEN=your_server_token
POSTMARK_FROM_EMAIL=your_verified_email@example.com
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_NAME=Notification System

# ---------- Web Push (OneSignal) ----------
ONESIGNAL_APP_ID=your_app_id
ONESIGNAL_REST_API_KEY=your_api_key

# ---------- Cron ----------
CRON_SECRET=my-cron-secret
